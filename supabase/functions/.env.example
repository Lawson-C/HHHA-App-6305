# Edge Function secrets. Copy to supabase/functions/.env for `npx supabase functions serve`
# (gitignored), or set on the hosted project with `npx supabase secrets set --env-file <file>`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the runtime; don't set them.

# send-alert: the secret configured on the Sanity webhook.
SANITY_WEBHOOK_SECRET=

# Shared with pg_cron (Vault secret `cron_secret`); send-reminders and sync-environment
# reject calls without `x-cron-secret: <this>`.
CRON_SECRET=

# Push is off unless this is true (alerts are still recorded, nothing is sent to Expo).
PUSH_ENABLED=false
# Only if "enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# sync-environment: NWS runs only when a contact User-Agent is set; AirNow only with a key.
NWS_USER_AGENT=
AIRNOW_API_KEY=
# Optional, default 33.759,-84.425 (District 3 centroid).
DISTRICT_CENTROID=

# send-reminders: optional Sanity lookup to drop reminders for deleted events and follow
# reschedules. Leave SANITY_PROJECT_ID empty to send reminders as stored.
SANITY_PROJECT_ID=nxvenp1m
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-19
# Only needed if the dataset is private.
SANITY_READ_TOKEN=
