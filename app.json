{
  "expo": {
    "name": "Hunter Hills",
    "slug": "historic-hunter-hills",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-ios.png",
    "scheme": "historichunterhills",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f7f5",
    "ios": {
      "bundleIdentifier": "org.historichunterhills",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.historichunterhills",
      "adaptiveIcon": {
        "backgroundColor": "#2a4d3a",
        "foregroundImage": "./assets/brand/icon-android-foreground.png",
        "monochromeImage": "./assets/brand/icon-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/icon-ios.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2a4d3a",
          "image": "./assets/brand/splash-monogram.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hunter Hills uses your location to tag where a reported problem is and to show conditions near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hunter Hills lets you attach photos to a report so the City can find the problem.",
          "cameraPermission": "Hunter Hills lets you take a photo of a problem you're reporting."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Hunter Hills adds community events you choose to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1a6232"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfec9b84-82de-4b35-a0c8-b6166f338e50"
      }
    }
  }
}
