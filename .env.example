# Copy to .env (gitignored). EXPO_PUBLIC_* values are bundled into the app and are PUBLIC by design.
# Never put the Supabase service-role/secret key, DB password, Sanity tokens, webhook/cron secrets
# or any third-party API key here: those live in Supabase Edge Function secrets (see docs/security.md).
# Leave the Supabase or Sanity values empty to run that half in demo mode (docs/decisions.md D-016).

# Supabase project (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Sanity content (public dataset, read without a token)
EXPO_PUBLIC_SANITY_PROJECT_ID=nxvenp1m
EXPO_PUBLIC_SANITY_DATASET=production
# Optional: the deployed Studio, e.g. https://<hostname>.sanity.studio
EXPO_PUBLIC_SANITY_STUDIO_URL=https://historic-hunter-hills.sanity.studio

# Local device builds without EAS (npm run ios:device). Your 10-character Apple Developer
# Team ID: developer.apple.com → Account → Membership details. Not secret, but machine-specific.
# APPLE_TEAM_ID=ABCDE12345

# Test account for `npm run test:contract` (hosted dev projects; created on the first run).
# CONTRACT_TEST_EMAIL=you+contract@example.com
# CONTRACT_TEST_PASSWORD=
