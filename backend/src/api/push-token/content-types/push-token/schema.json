{
  "kind": "collectionType",
  "collectionName": "push_tokens",
  "info": {
    "singularName": "push-token",
    "pluralName": "push-tokens",
    "displayName": "Push token",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "token": {
      "type": "string",
      "required": true,
      "unique": true,
      "column": {
