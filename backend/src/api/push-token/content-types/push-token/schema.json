      },
      "private": true
    },
    "profile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "private": true
    },
    "platform": {
      "type": "enumeration",
      "enum": [
        "ios",
        "android"
      ]
    },
    "lastRegisteredAt": {
      "type": "datetime"
    }
  }
}
