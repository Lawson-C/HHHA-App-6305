{
  "kind": "collectionType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Profile",
    "description": "App user profile, one per Supabase auth user. Role and status are only changed by admins."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "supabaseUserId": {
      "type": "string",
      "required": true,
      "unique": true,
      "column": {
        "unique": true
      }
    },
    "fullName": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 100
    },
    "email": {
      "type": "email",
      "private": true
    },
    "phone": {
      "type": "string",
      "private": true,
      "regex": "^\\+[1-9]\\d{1,14}$"
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "resident",
        "admin"
      ],
      "default": "resident",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "suspended",
        "banned"
      ],
      "default": "active",
      "required": true
    },
    "suspendedUntil": {
      "type": "datetime"
    },
    "notificationPreferences": {
      "type": "component",
      "repeatable": false,
      "component": "notification.preferences"
    },
    "lastSeenAt": {
      "type": "datetime"
    },
    "neighborhood": {
      "type": "enumeration",
      "enum": [
        "english_avenue",
        "vine_city",
        "hunter_hills",
        "washington_park",
        "bankhead",
        "knight_park",
        "dixie_hills",
        "west_lake",
        "center_hill",
        "harvel_homes",
        "georgia_tech"
      ]
    },
    "textSize": {
      "type": "enumeration",
      "enum": [
        "default",
        "large",
        "extra_large"
      ],
      "default": "default"
    },
    "language": {
      "type": "enumeration",
      "enum": [
        "en",
        "es"
      ],
      "default": "en"
    }
  }
}
