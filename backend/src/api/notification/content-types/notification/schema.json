{
  "kind": "collectionType",
  "collectionName": "notifications",
  "info": {
    "singularName": "notification",
    "pluralName": "notifications",
    "displayName": "Notification",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 65
    },
    "message": {
      "type": "text",
      "required": true,
      "maxLength": 240
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "emergency",
        "health_warning",
        "community_announcement",
        "meeting_reminder"
      ],
      "required": true
    },
    "issuer": {
      "type": "string"
    },
    "body": {
      "type": "text"
    },
    "actionSteps": {
      "type": "json"
    },
    "affectedArea": {
      "type": "text"
    },
    "endsAt": {
      "type": "datetime"
    },
    "sentBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "private": true
    },
    "sentAt": {
      "type": "datetime"
    },
    "recipientCount": {
      "type": "integer",
      "private": true
    }
  }
}
