{
  "kind": "collectionType",
  "collectionName": "housing_listings",
  "info": {
    "singularName": "housing-listing",
    "pluralName": "housing-listings",
    "displayName": "Housing listing",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "neighborhood": {
      "type": "enumeration",
      "enum": [
        "english_avenue",
        "vine_city",
        "hunter_hills",
        "washington_park",
        "bankhead",
        "knight_park",
        "dixie_hills",
        "west_lake",
        "center_hill",
        "harvel_homes",
        "georgia_tech"
      ]
    },
    "rentLabel": {
      "type": "string"
    },
    "bedrooms": {
      "type": "integer",
      "min": 0
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "url": {
      "type": "string"
    },
    "availableFrom": {
      "type": "date"
    }
  }
}
