{
  "kind": "collectionType",
  "collectionName": "housing_inquiries",
  "info": {
    "singularName": "housing-inquiry",
    "pluralName": "housing-inquiries",
    "displayName": "Housing inquiry",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "profile": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "private": true
    },
    "housingResource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::housing-resource.housing-resource"
    },
    "message": {
      "type": "text",
      "required": true,
      "maxLength": 4000
    },
    "preferredContact": {
      "type": "enumeration",
      "enum": [
        "email",
        "phone"
      ],
      "required": true
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ],
      "private": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "in_progress",
        "closed"
      ],
      "default": "new",
      "required": true
    },
    "adminNotes": {
      "type": "text",
      "private": true
    }
  }
}
