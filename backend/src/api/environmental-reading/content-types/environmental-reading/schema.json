{
  "kind": "collectionType",
  "collectionName": "environmental_readings",
  "info": {
    "singularName": "environmental-reading",
    "pluralName": "environmental-readings",
    "displayName": "Environmental reading",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "source": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::environmental-source.environmental-source"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "temperature",
        "air_quality",
        "water_quality",
        "mosquito",
        "heat"
      ],
      "required": true
    },
    "latitude": {
      "type": "decimal"
    },
    "longitude": {
      "type": "decimal"
    },
    "value": {
      "type": "decimal"
    },
    "unit": {
      "type": "string"
    },
    "level": {
      "type": "enumeration",
      "enum": [
        "good",
        "moderate",
        "unhealthy_sensitive",
        "unhealthy",
        "very_unhealthy",
        "hazardous",
        "unknown"
      ],
      "default": "unknown"
    },
    "summary": {
      "type": "string"
    },
    "observedAt": {
      "type": "datetime"
    },
    "raw": {
      "type": "json",
      "private": true
    }
  }
}
