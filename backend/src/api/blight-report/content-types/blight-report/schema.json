{
  "kind": "collectionType",
  "collectionName": "blight_reports",
  "info": {
    "singularName": "blight-report",
    "pluralName": "blight-reports",
    "displayName": "Blight report",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "category": {
      "type": "enumeration",
      "enum": [
        "illegal_dumping",
        "vacant_lot",
        "abandoned_building",
        "standing_water",
        "air_odor",
        "other"
      ],
      "required": true
    },
    "description": {
      "type": "text",
      "maxLength": 2000
    },
    "keepNamePrivate": {
      "type": "boolean",
      "default": true
    },
    "latitude": {
      "type": "decimal",
      "required": true
    },
    "longitude": {
      "type": "decimal",
      "required": true
    },
    "address": {
      "type": "string"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "submitted",
        "under_review",
        "reported_to_city",
        "resolved",
        "removed"
      ],
      "default": "submitted",
      "required": true
    },
    "statusHistory": {
      "type": "json"
    },
    "resolutionNote": {
      "type": "text"
    },
    "resolvedAt": {
      "type": "datetime"
    },
    "reporter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::profile.profile",
      "private": true
    }
  }
}
