{
  "kind": "collectionType",
  "collectionName": "library_resources",
  "info": {
    "singularName": "library-resource",
    "pluralName": "library-resources",
    "displayName": "Library resource",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "education",
        "financial_tools",
        "health",
        "small_business"
      ],
      "required": true
    },
    "resourceType": {
      "type": "enumeration",
      "enum": [
        "article",
        "video",
        "link"
      ],
      "required": true
    },
    "url": {
      "type": "string"
    },
    "body": {
      "type": "richtext"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "source": {
      "type": "string"
    },
    "durationMinutes": {
      "type": "integer",
      "min": 0
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
