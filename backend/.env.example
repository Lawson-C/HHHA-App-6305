# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env.

# --- Server ---
HOST=0.0.0.0
PORT=1337
# Public URL of this Strapi instance (set in production, e.g. https://api.example.org)
# PUBLIC_URL=

# --- Secrets ---
# Generate each with:  node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS is a comma-separated list of (at least two) such values.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Database (Postgres) ---
# Defaults below match docker-compose.yml (local dev).
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
# Strapi's tables live in this schema (kept out of Supabase's `public`). Must already exist.
DATABASE_SCHEMA=strapi
DATABASE_SSL=false
# Optional: a full connection string. When set, it overrides HOST/PORT/NAME/USERNAME/PASSWORD.
# Supabase (session pooler, port 5432) — do not append ?sslmode=..., use DATABASE_SSL instead:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# For Supabase also set:
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # or keep true and set DATABASE_SSL_CA to Supabase's CA cert
# DATABASE_SSL_CA=
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000

# --- Supabase Auth (identity bridge, src/middlewares/supabase-auth.ts) ---
# Strapi verifies the app's Supabase access tokens. Required outside tests.
SUPABASE_URL=https://<project-ref>.supabase.co
# Optional. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (ES256/RS256 signing keys).
# SUPABASE_JWKS_URL=
# Optional, LEGACY: the HS256 shared JWT secret. HS256 tokens are rejected unless this is set.
# Prefer asymmetric signing keys in the Supabase dashboard and leave this empty.
# SUPABASE_JWT_SECRET=
# Optional. Expected `aud` claim.
# SUPABASE_JWT_AUDIENCE=authenticated

# --- Uploads: Supabase Storage through its S3-compatible endpoint (config/plugins.ts) ---
# Only active when ALL five SUPABASE_S3_* values below are set; otherwise uploads go to
# backend/public/uploads (local provider).
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=<region>
# SUPABASE_S3_BUCKET=strapi-uploads
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# true = private bucket: Strapi returns short-lived signed URLs (seconds below, default 900).
# SUPABASE_S3_PRIVATE=false
# SUPABASE_S3_SIGNED_URL_EXPIRES=900

# --- District 3 geography (config/hhha.ts) ---
# Blight reports must fall inside this box: minLat,minLng,maxLat,maxLng
# DISTRICT_BBOX=33.73,-84.49,33.81,-84.37
# Point used for environmental data: lat,lng
# DISTRICT_CENTROID=33.759,-84.425

# --- Push notifications (Expo Push API) ---
# false (default): notifications are stored and recipients counted, but nothing is sent.
PUSH_ENABLED=false
# Only needed if "enhanced push security" is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=

# --- Environmental data sync (cron, every 30 min) ---
# NWS (api.weather.gov, no key): temperature, hourly forecast, heat index / heat alerts.
ENVIRONMENT_SYNC_ENABLED=false
# NWS asks for a User-Agent with contact info. Replace the placeholder before enabling.
# NWS_USER_AGENT=HistoricHunterHillsApp/0.1 (contact@example.org)
# EPA AirNow (free key from https://docs.airnowapi.org/). AQI sync runs whenever this is set.
# AIRNOW_API_KEY=

# --- Cron ---
# Set to false to disable all scheduled jobs (environment sync, reminders, reading pruning).
# CRON_ENABLED=true
